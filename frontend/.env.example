# Optional. Only needed if the frontend and backend are NOT served from
# the same origin (e.g. deployed separately, or you skip the Vite proxy).
# For local dev with the default setup, leave this unset or commented out -
# requests fall back to the relative "/api" path, which vite.config.js
# proxies to http://localhost:5000.
# VITE_API_BASE_URL=http://localhost:5000/api
